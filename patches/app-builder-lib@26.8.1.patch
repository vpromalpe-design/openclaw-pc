+; ═══ Liquid Glass dark theme — page repaint functions ═══
+; Defined here (end of assistedInstaller.nsh): every page above has already
+; been declared, so all $mui.* and $MultiUser.* variables exist.
+;
+; Buttons / radio buttons / checkboxes are themed dark with the undocumented
+; "DarkMode_Explorer" uxtheme (Windows 10 1809+). Older systems fall back to
+; the classic theme + white text so labels stay readable on the dark page.
+
+!macro DarkControl HWND
+  ; uxtheme-themed controls ignore WM_CTLCOLOR* — strip the theme so
+  ; SetCtlColors actually paints them (same trick as the Finish checkbox).
+  System::Call 'uxtheme.dll::SetWindowTheme(i ${HWND}, w " ", w " ") i .r0'
+  SetCtlColors ${HWND} "F2F4F8" "0B1020"
+!macroend
+
+!macro DarkPageCommon
+  ; Dialog background — visible in the gaps around controls and in the
+  ; bottom button strip. SetCtlColors supports dialog windows directly.
+  SetCtlColors $HWNDPARENT "F2F4F8" "0B1020"
+  ; Bottom branding strip (outer dialog, present on every page).
+  SetCtlColors $mui.Branding.Background "" "0B1020"
+  SetCtlColors $mui.Branding.Text "F2F4F8" "0B1020"
+  ; Wizard navigation buttons.
+  !insertmacro DarkControl $mui.Button.Back
+  !insertmacro DarkControl $mui.Button.Next
+  !insertmacro DarkControl $mui.Button.Cancel
+!macroend
+
+!macro DarkThemePages PREFIX
+; Each page function is only emitted when its MUI page actually exists in
+; this build (installer vs uninstaller), so makensis -WX never sees an
+; unreferenced function (warning 6010) or an unknown variable (6000).
+;
+; License page (installer only): rich edit gets a dark background + white text
+; (SetCtlColors cannot paint RichEdit controls — EM_SETBKGNDCOLOR/EM_SETCHARFORMAT).
+!ifdef MUI_LICENSEPAGE_INTERFACE
+Function ${PREFIX}darkLicenseShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.Licensepage.TopText "F2F4F8" "0B1020"
+  SetCtlColors $mui.Licensepage.Text "F2F4F8" "0B1020"
+  ; EM_SETBKGNDCOLOR = 0x0403, wParam unused, lParam = COLORREF (0x00BBGGRR) 0x0020100B.
+  System::Call 'user32::SendMessage(i $mui.Licensepage.LicenseText, i 0x0403, i 0, i 0x0020100B) i .r0'
+  ; EM_SETCHARFORMAT = 0x0444, wParam = SCF_ALL (4), lParam = CHARFORMAT2A.
+  ; Struct: cbSize(84) dwMask(CFM_COLOR=0x40000000) dwEffects yHeight yOffset
+  ; crTextColor(0x00F8F4F2 = COLORREF of #F2F4F8) bCharSet bPitchAndFamily szFaceName[32]
+  ; wWeight sSpacing crBackColor lcid dwReserved sStyle wKerning bUnderline*
+  System::Call '*(i 84, i 0x40000000, i 0, i 0, i 0, i 0x00F8F4F2, i 0, i 0, s "", i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0) i .r0'
+  System::Call 'user32::SendMessage(i $mui.Licensepage.LicenseText, i 0x0444, i 4, i r0) i .r1'
+  System::Free $0
+FunctionEnd
+!endif
+
+; "Who should this be installed for" page (nsDialogs, multiUserUi.nsh) — the
+; guard define differs between installer (…INSTALLMODEPAGE) and uninstaller.
+!ifdef MULTIUSER_INSTALLMODEPAGE
+Function ${PREFIX}darkModePageShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $MultiUser.InstallModePage "F2F4F8" "0B1020"
+  SetCtlColors $MultiUser.InstallModePage.Text "F2F4F8" "0B1020"
+  SetCtlColors $RadioButtonLabel1 "F2F4F8" "0B1020"
+  !insertmacro DarkControl $MultiUser.InstallModePage.AllUsers
+  !insertmacro DarkControl $MultiUser.InstallModePage.CurrentUser
+FunctionEnd
+!endif
+
+; "Choose installation folder" page (installer only).
+!ifdef MUI_DIRECTORYPAGE_INTERFACE
+Function ${PREFIX}darkDirShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.DirectoryPage "F2F4F8" "0B1020"
+  SetCtlColors $mui.DirectoryPage.Text "F2F4F8" "0B1020"
+  SetCtlColors $mui.DirectoryPage.SpaceRequired "F2F4F8" "0B1020"
+  SetCtlColors $mui.DirectoryPage.SpaceAvailable "F2F4F8" "0B1020"
+  SetCtlColors $mui.DirectoryPage.Directory "F2F4F8" "0B1020"
+  !insertmacro DarkControl $mui.DirectoryPage.BrowseButton
+FunctionEnd
+!endif
+
+; "Installing" progress page.
+!ifdef MUI_INSTFILESYPAGE_INTERFACE
+Function ${PREFIX}darkInstShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.InstFilesPage "F2F4F8" "0B1020"
+  SetCtlColors $mui.InstFilesPage.Text "F2F4F8" "0B1020"
+FunctionEnd
+!endif
+
+; Finish page: white "Run OpenClaw PC" checkbox label. MUI2 paints the
+; checkbox with SetCtlColors but themed checkboxes ignore WM_CTLCOLORSTATIC
+; (NSIS bug #443) leaving black text on our dark background — resetting the
+; uxtheme makes WM_CTLCOLORSTATIC work again.
+!ifdef MUI_FINISHPAGE_INTERFACE
+Function ${PREFIX}darkFinishShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.FinishPage.Title "F2F4F8" "0B1020"
+  SetCtlColors $mui.FinishPage.Text "F2F4F8" "0B1020"
+  ${If} $mui.FinishPage.Run <> 0
+    ${If} ${AtLeastWin10}
+      System::Call 'uxtheme.dll::SetWindowTheme(i $mui.FinishPage.Run, w "DarkMode_Explorer", w "") i .r0'
+    ${Else}
+      System::Call 'uxtheme.dll::SetWindowTheme(i $mui.FinishPage.Run, w " ", w " ") i .r0'
+    ${EndIf}
+    SetCtlColors $mui.FinishPage.Run "F2F4F8" "0B1020"
+  ${EndIf}
+FunctionEnd
+!endif
+
+; Uninstaller welcome page (uninstaller only).
+!ifdef MUI_WELCOMEPAGE_INTERFACE
+Function ${PREFIX}darkWelcomeShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.WelcomePage.Title "F2F4F8" "0B1020"
+  SetCtlColors $mui.WelcomePage.Text "F2F4F8" "0B1020"
+FunctionEnd
+!endif
+!macroend
+
+!ifdef BUILD_UNINSTALLER
+  !insertmacro DarkThemePages "un."
+!else
+  !insertmacro DarkThemePages ""
+!endif
