+
+; ═══ Liquid Glass light theme — page repaint functions ═══
+; Defined here (end of assistedInstaller.nsh): every page above has already
+; been declared, so all $mui.* and $MultiUser.* variables exist.
+;
+; Light theme: white page background + dark text (#10131C, the app's
+; light-theme text color). uxtheme is stripped so SetCtlColors actually
+; paints labels/buttons (NSIS bug #443 workaround).
+
+!macro DarkControl HWND
+  ; Light theme: strip uxtheme so SetCtlColors actually paints (same trick as
+  ; the Finish checkbox) and force dark text on the white page.
+  System::Call 'uxtheme.dll::SetWindowTheme(i ${HWND}, w " ", w " ") i .r0'
+  SetCtlColors ${HWND} "10131C" "FFFFFF"
+!macroend
+
+!macro DarkPageCommon
+  ; Bottom branding strip (outer dialog, present on every page).
+  SetCtlColors $mui.Branding.Background "" "FFFFFF"
+  SetCtlColors $mui.Branding.Text "10131C" "FFFFFF"
+  ; Wizard navigation buttons.
+  !insertmacro DarkControl $mui.Button.Back
+  !insertmacro DarkControl $mui.Button.Next
+  !insertmacro DarkControl $mui.Button.Cancel
+!macroend
+
+!macro DarkThemePages PREFIX
+; License page: rich edit gets a white background + dark text (SetCtlColors
+; cannot paint RichEdit controls — use EM_SETBKGNDCOLOR / EM_SETCHARFORMAT).
+; Guarded: the $mui.Licensepage.* variables are only declared by MUI2's
+; Pages\License.nsh when MUI_PAGE_LICENSE is used, so defining this function
+; unconditionally would trip makensis -WX (warning 6000).
+!ifdef MUI_LICENSEPAGE_INTERFACE
+Function ${PREFIX}darkLicenseShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.Licensepage.TopText "10131C" "FFFFFF"
+  SetCtlColors $mui.Licensepage.Text "10131C" "FFFFFF"
+  ; EM_SETBKGNDCOLOR = 0x0403, wParam unused, lParam = COLORREF 0x00FFFFFF.
+  System::Call 'user32::SendMessage(i $mui.Licensepage.LicenseText, i 0x0403, i 0, i 0x00FFFFFF) i .r0'
+  ; EM_SETCHARFORMAT = 0x0444, wParam = SCF_ALL (4), lParam = CHARFORMAT2A.
+  ; Struct: cbSize(84) dwMask(CFM_COLOR=0x40000000) dwEffects yHeight yOffset
+  ; crTextColor(0x001C1310) bCharSet bPitchAndFamily szFaceName[32]
+  ; wWeight sSpacing crBackColor lcid dwReserved sStyle wKerning bUnderline*
+  System::Call '*(i 84, i 0x40000000, i 0, i 0, i 0, i 0x001C1310, i 0, i 0, s "", i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0, i 0) i .r0'
+  System::Call 'user32::SendMessage(i $mui.Licensepage.LicenseText, i 0x0444, i 4, i r0) i .r1'
+  System::Free $0
+FunctionEnd
+!endif
+
+; "Who should this be installed for" page (nsDialogs, multiUserUi.nsh).
+Function ${PREFIX}darkModePageShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $MultiUser.InstallModePage "10131C" "FFFFFF"
+  SetCtlColors $MultiUser.InstallModePage.Text "10131C" "FFFFFF"
+  SetCtlColors $RadioButtonLabel1 "10131C" "FFFFFF"
+  !insertmacro DarkControl $MultiUser.InstallModePage.AllUsers
+  !insertmacro DarkControl $MultiUser.InstallModePage.CurrentUser
+FunctionEnd
+
+; "Choose installation folder" page.
+Function ${PREFIX}darkDirShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.DirectoryPage "10131C" "FFFFFF"
+  SetCtlColors $mui.DirectoryPage.Text "10131C" "FFFFFF"
+  SetCtlColors $mui.DirectoryPage.SpaceRequired "10131C" "FFFFFF"
+  SetCtlColors $mui.DirectoryPage.SpaceAvailable "10131C" "FFFFFF"
+  SetCtlColors $mui.DirectoryPage.Directory "10131C" "FFFFFF"
+  !insertmacro DarkControl $mui.DirectoryPage.BrowseButton
+FunctionEnd
+
+; "Installing" progress page.
+Function ${PREFIX}darkInstShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.InstFilesPage "10131C" "FFFFFF"
+  SetCtlColors $mui.InstFilesPage.Text "10131C" "FFFFFF"
+FunctionEnd
+
+; Finish page: white "Run OpenClaw PC" checkbox label. MUI2 paints the
+; checkbox with SetCtlColors but themed checkboxes ignore WM_CTLCOLORSTATIC
+; (NSIS bug #443) leaving black text on our dark background — resetting the
+; uxtheme makes WM_CTLCOLORSTATIC work again.
+Function ${PREFIX}darkFinishShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.FinishPage.Title "10131C" "FFFFFF"
+  SetCtlColors $mui.FinishPage.Text "10131C" "FFFFFF"
+  ${If} $mui.FinishPage.Run <> 0
+    System::Call 'uxtheme.dll::SetWindowTheme(i $mui.FinishPage.Run, w " ", w " ") i .r0'
+    SetCtlColors $mui.FinishPage.Run "10131C" "FFFFFF"
+  ${EndIf}
+FunctionEnd
+
+; Uninstaller welcome page.
+Function ${PREFIX}darkWelcomeShow
+  !insertmacro DarkPageCommon
+  SetCtlColors $mui.WelcomePage.Title "10131C" "FFFFFF"
+  SetCtlColors $mui.WelcomePage.Text "10131C" "FFFFFF"
+FunctionEnd
+!macroend
+
+!ifdef BUILD_UNINSTALLER
+  !insertmacro DarkThemePages "un."
+!else
+  !insertmacro DarkThemePages ""
+!endif
